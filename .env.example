# ========================================================
# MASSA & GIZEY PLATFORM ENVIRONMENT CONFIGURATION
# ========================================================

# In LOCAL DEVELOPMENT:
# You do NOT need any MySQL variables. The app automatically defaults to SQLite (data/database.sqlite).
# DB_CONNECTION=sqlite

# In PRODUCTION (Hostinger Shared Hosting):
# Set DB_CONNECTION to mysql, and provide your Hostinger MySQL database credentials:
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_massa_gizey
DB_USERNAME=u123456789_user
DB_PASSWORD=your_strong_password_here

# (Optional alternative naming supported: MYSQL_HOST, MYSQL_PORT, MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD)
